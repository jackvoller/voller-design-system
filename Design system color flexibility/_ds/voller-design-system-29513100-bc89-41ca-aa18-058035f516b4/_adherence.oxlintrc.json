{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/web/**",
              "sources/**",
              "ui_kits/app-icons/**",
              "ui_kits/app-store/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppStoreBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|className|key|ref|className|style|children)$/]",
        "message": "<AppStoreBadge> doesn't accept that prop. Declared props: href, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:app|src|size|plate|plateSize|alt|base|className|key|ref|className|style|children)$/]",
        "message": "<AppTile> doesn't accept that prop. Declared props: app, src, size, plate, plateSize, alt, base, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppTile'] > JSXAttribute[name.name='app'] > Literal[value!=/^(?:unpickle|unjumble|riverly|meal-planner|voller)$/]",
        "message": "<AppTile> app must be one of 'unpickle' | 'unjumble' | 'riverly' | 'meal-planner' | 'voller'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|iconLeft|iconRight|block|disabled|href|type|onClick|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, iconLeft, iconRight, block, disabled, href, type, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|quiet|destructive|gold)$/]",
        "message": "<Button> variant must be one of 'primary' | 'quiet' | 'destructive' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|children|footer|tight|sunken|href|accent|className|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: eyebrow, title, children, footer, tight, sunken, href, accent, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|icon|onClick|className|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: variant, children, icon, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:tint|selected|alert|outline)$/]",
        "message": "<Chip> variant must be one of 'tint' | 'selected' | 'alert' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|className|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, as, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|src|alt|children|className|key|ref|className|style|children)$/]",
        "message": "<GlassRing> doesn't accept that prop. Declared props: size, src, alt, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|note|error|textarea|strong|id|placeholder|value|rows|onChange|className|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, note, error, textarea, strong, id, placeholder, value, rows, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|className|style|children)$/]",
        "message": "<ListGroup> doesn't accept that prop. Declared props: children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|chevron|control|variant|onClick|children|className|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: label, value, chevron, control, variant, onClick, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|action|danger)$/]",
        "message": "<ListRow> variant must be one of 'default' | 'action' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|current|className|key|ref|className|style|children)$/]",
        "message": "<PageTabs> doesn't accept that prop. Declared props: tabs, current, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlanCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|was|blurb|features|featured|className|key|ref|className|style|children)$/]",
        "message": "<PlanCard> doesn't accept that prop. Declared props: name, price, was, blurb, features, featured, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|status|description|app|icon|accent|href|base|className|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, status, description, app, icon, accent, href, base, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute[name.name='app'] > Literal[value!=/^(?:unpickle|unjumble|riverly|meal-planner|voller)$/]",
        "message": "<ProductCard> app must be one of 'unpickle' | 'unjumble' | 'riverly' | 'meal-planner' | 'voller'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:violet|lime|orange|blue)$/]",
        "message": "<ProductCard> accent must be one of 'violet' | 'lime' | 'orange' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|children|className|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: eyebrow, title, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segmented'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|className|key|ref|className|style|children)$/]",
        "message": "<Segmented> doesn't accept that prop. Declared props: options, value, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:products|base|year|className|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: products, base, year, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:products|base|onNavigate|sticky|className|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: products, base, onNavigate, sticky, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|onChange|label|className|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, min, max, onChange, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|children|className|key|ref|className|style|children)$/]",
        "message": "<StepCard> doesn't accept that prop. Declared props: number, title, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='TickList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|card|className|key|ref|className|style|children)$/]",
        "message": "<TickList> doesn't accept that prop. Declared props: items, card, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|className|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|href|onDark|as|className|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, href, onDark, as, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
