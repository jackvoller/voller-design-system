name":"Listing sheet"},{"path":"guidelines/brand-glass-ring.card.html","group":"Brand","viewport":"700x170","subtitle":"A circle at r+7%, .62 white fill and a .9 white stroke. The token that ties the web to the icons.","name":"Glass ring"},{"path":"guidelines/brand-gold-rule.card.html","group":"Brand","viewport":"700x200","subtitle":"One gold per view, on the verb. In a header that gold is the wordmark tile.","name":"The gold rule"},{"path":"guidelines/brand-tiles.card.html","group":"Brand","viewport":"700x190","subtitle":"Four apps and the house mark, all at 23.5% squircle. Never circular, never shadowed.","name":"App tiles"},{"path":"guidelines/brand-wordmark.card.html","group":"Brand","viewport":"700x160","subtitle":"The word carries the name. One gold tile as a full stop — tile 0.33 × cap height, gap 0.2.","name":"Wordmark"},{"path":"guidelines/colour-alert.card.html","group":"Colors","viewport":"700x150","subtitle":"Safety and destruction only. Not a highlight, not decoration.","name":"Alert pair"},{"path":"guidelines/colour-cream-ink.card.html","group":"Colors","viewport":"700x150","subtitle":"Warm surfaces both ways. #1C1C1E is the tell that a dark mode is not ours.","name":"Creams and inks"},{"path":"guidelines/colour-fields.card.html","group":"Colors","viewport":"700x160","subtitle":"160°, cream to cream, and warm charcoal to ink. No third gradient may be invented.","name":"The two fields"},{"path":"guidelines/colour-fills.card.html","group":"Colors","viewport":"700x150","subtitle":"One button, no dark variant: a green or gold fill always carries an ink label.","name":"Filled surfaces take ink"},{"path":"guidelines/colour-gold.card.html","group":"Colors","viewport":"700x150","subtitle":"The action colour. Exactly once per view, on the thing the user came to do.","name":"Gold"},{"path":"guidelines/colour-green.card.html","group":"Colors","viewport":"700x150","subtitle":"One hue, three steps. Flat fills only — green is never a gradient.","name":"Green ramp"},{"path":"guidelines/colour-hairlines.card.html","group":"Colors","viewport":"700x170","subtitle":"Hierarchy is a 1px rule or a background step. There are no drop shadows in the system.","name":"Hairlines, not shadows"},{"path":"guidelines/colour-text.card.html","group":"Colors","viewport":"700x170","subtitle":"Two muteds, one per field, both 5.0:1. #8A8A8A on light is 3.4:1 and forbidden.","name":"Text colours"},{"path":"guidelines/colour-tint-flip.card.html","group":"Colors","viewport":"700x150","subtitle":"--tint is the one token that changes between fields: green-dark on light, green on dark.","name":"The tint flips"},{"path":"components/brand/brand.card.html","group":"Components","viewport":"700x300","subtitle":"Wordmark sizes, app tiles at 23.5%, the glass ring, eyebrows, Lucide icons","name":"Brand marks"},{"path":"components/core/core.card.html","group":"Components","viewport":"700x560","subtitle":"Buttons, card, list rows, input, segmented, toggle, slider, chips — both fields","name":"Core controls"},{"path":"components/web/web.card.html","group":"Components","viewport":"700x600","subtitle":"Header, product card, steps, plans, tick lists, tabs, App Store badge, footer","name":"Web surfaces"},{"path":"guidelines/motion.card.html","group":"Motion","viewport":"700x160","subtitle":"120ms colour, 180ms movement, cubic-bezier(.2,.6,.2,1). No bounces, springs, parallax or scroll reveals.","name":"Motion"},{"path":"guidelines/space-radii.card.html","group":"Spacing","viewport":"700x160","subtitle":"Card 20, row 16, control 10, pill 999, app tile 23.5% — and the tile is never a circle.","name":"Radii"},{"path":"guidelines/space-rhythm.card.html","group":"Spacing","viewport":"700x190","subtitle":"A section: eyebrow, heading, copy at 16 — then 32 to the grid, 72 to the next section.","name":"Rhythm in use"},{"path":"guidelines/space-scale.card.html","group":"Spacing","viewport":"700x150","subtitle":"8px base. Section rhythm 24 / 32 / 56 / 72. Flex or grid with gap — never margin-per-child.","name":"Spacing scale"},{"path":"guidelines/type-body.card.html","group":"Type","viewport":"700x190","subtitle":"Body 16/1.6, Small 14, Caption 12 — all 400. Long-form copy gets text-wrap: pretty.","name":"Body ladder"},{"path":"guidelines/type-headings.card.html","group":"Type","viewport":"700x210","subtitle":"Display 44 / H1 34 / H2 22, all 600 at -0.02em. One ladder, both platforms.","name":"Heading ladder"},{"path":"guidelines/type-mono.card.html","group":"Type","viewport":"700x150","subtitle":"The only monospace on a Voller surface: eyebrows, spec labels and code. 11–12px, .1em, uppercase.","name":"Mono eyebrows"},{"path":"guidelines/type-weights.card.html","group":"Type","viewport":"700x140","subtitle":"400, 500, 600 only. 700 and above are unused — that rule is what makes the family look like one family.","name":"Weights"},{"path":"ui_kits/website/index.html","group":"Website","viewport":"1280x900","subtitle":"The hub, a product page, changelog and support — click through","name":"voller.uk"}],"templates":[{"name":"Product page","description":"A Voller product marketing page: header, hero with app tile, three steps, tick list, plans and closing.","folder":"templates/product-page","entryPath":"templates/product-page/ProductPage.dc.html"}],"hasThumbnailHtml":true,"globalCssPaths":["tokens/colors.css","tokens/typography.css","tokens/spacing.css","tokens/radii.css","tokens/effects.css","tokens/motion.css","tokens/semantic.css","tokens/base.css","css/components.css","styles.css"],"tokens":[{"name":"--green","value":"#82BA51","kind":"color","definedIn":"tokens/colors.css"},{"name":"--green-deep","value":"#69A63C","kind":"color","definedIn":"tokens/colors.css"},{"name":"--green-dark","value":"#3F6B27","kind":"color","definedIn":"tokens/colors.css"},{"name":"--gold","value":"#F0C21C","kind":"color","definedIn":"tokens/colors.css"},{"name":"--cream","value":"#F6F1E3","kind":"color","definedIn":"tokens/colors.css"},{"name":"--cream-dark","value":